# ============================================================
#  EplyD platform configuration
#  Copy to `.env` and adjust. NEVER commit the real .env.
#  Tuned by default for a 32 GB RAM / 98 GB disk host.
# ============================================================

# --- Core ---
PORT=3000
# Bind address. Keep 127.0.0.1 in production (Cloudflare Tunnel / local proxy
# connects locally). Set 0.0.0.0 only for direct LAN testing.
HOST=127.0.0.1

# All projects, logs, databases and caches live here. Back this one directory
# up and you can rebuild the whole platform without losing a single bot.
DATA_DIR=/opt/eplyd/data
CACHE_DIR=/opt/eplyd/cache

# Public URL behind Cloudflare Tunnel (used in webhooks + CSP).
PUBLIC_URL=https://eplyd.dpdns.org

# --- Secrets ---
# Owner password used at first login. It is hashed (argon2id) on boot and the
# plaintext is never stored or logged. Quote values containing special chars:
ADMIN_PASSWORD="change-me"
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-openssl-rand-hex-32"
# Generate with: openssl rand -hex 32
# BACK THIS UP SECURELY: bot environment variables cannot be decrypted without it.
ENCRYPTION_KEY="replace-with-openssl-rand-hex-32"

# --- Limits (sized for 32 GB RAM / 98 GB disk) ---
# Max ZIP upload size. 2 GB is comfortable on a 98 GB disk.
MAX_UPLOAD_MB=2048
# Dependency installs run in parallel up to this many (3 keeps the CPU cool
# while bots keep serving; raise to 6 if you deploy in bulk often).
MAX_CONCURRENT_INSTALLS=3
# RAM reserved for the platform + OS. Bot memory pool = total - reserve.
# 4 GB reserved leaves ~28 GB for bots on a 32 GB host. The dashboard shows
# the live pool usage on the host capacity panel.
PLATFORM_RESERVED_RAM_MB=4096

# --- Optional ---
# HMAC secret for the platform auto-update webhook (POST /api/v1/hooks/github)
GITHUB_WEBHOOK_SECRET=
LOG_LEVEL=info
